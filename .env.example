# =============================================================================
# DocumentDataParse — пример окружения
# Скопируйте в .env и заполните секреты:
#   copy .env.example .env
# =============================================================================

# --- Доступ к этому API ---
APP_API_KEY=change-me-strong-secret

# --- Yandex Cloud ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- HTTP-сервер ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Бюджет контекста GPT ---
# Макс. длина всего запроса (system + user) ≈ GPT_MAX_INPUT_TOKENS * CHARS_PER_TOKEN символов
GPT_MAX_INPUT_TOKENS=32760
CHARS_PER_TOKEN=2

# --- Ретраи ---
# N — повторы одного блока при ошибке JSON/API
# M — полные перезапуски анализа файла
GPT_BLOCK_RETRIES=3
GPT_ANALYSIS_RETRIES=2

# --- Лимиты загрузки ---
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=100

# --- Эвристика PDF (текст vs скан / Vision) ---
PDF_MIN_CHARS_PER_PAGE=50
PDF_SCAN_IMAGE_PAGE_RATIO=0.5
PDF_IMAGE_PAGE_AREA_RATIO=0.35
PDF_FORCE_VISION=false
PDF_FORCE_TEXT=false

# --- YandexGPT (Lite + async = дешевле) ---
YANDEX_GPT_MODEL=yandexgpt-lite/latest
YANDEX_GPT_TEMPERATURE=0.1
YANDEX_GPT_MAX_TOKENS=2000
YANDEX_GPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completionAsync
YANDEX_OPERATIONS_API_URL=https://operation.api.cloud.yandex.net/operations
# Таймаут одного HTTP (submit / poll)
GPT_HTTP_TIMEOUT_SECONDS=60
# Сколько ждать одну async-генерацию целиком
GPT_ASYNC_TIMEOUT_SECONDS=300
GPT_ASYNC_POLL_INTERVAL_SECONDS=1

# --- Yandex Vision OCR ---
YANDEX_VISION_API_URL=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
VISION_HTTP_TIMEOUT_SECONDS=120
# Scanned PDFs: render each page to JPEG (sync OCR page limit / decode issues on raw PDF).
VISION_OCR_DPI=150
# Sync Vision quota is ~1 request/sec.
VISION_REQUEST_INTERVAL_SECONDS=1.1
VISION_LANGUAGE_CODES=ru,en
VISION_TEXT_TYPES=printed

# --- Промпт системы (файл в корне проекта) ---
SYSTEM_PROMPT_FILE=system_prompt.txt

# --- Merge результатов блоков ---
# true  — разрешена осторожная перезапись уже найденных полей
# false — перезапись запрещена (ошибка / ретрай блока)
MERGE_ALLOW_OVERWRITE=true

# --- Логирование (Loguru) ---
LOG_DIR=logs
LOG_RETENTION=30 days
LOG_LEVEL=INFO

# --- Временные файлы загрузок ---
TEMP_DIR=tmp_uploads

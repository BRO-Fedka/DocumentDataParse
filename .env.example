# Access to this API
APP_API_KEY=change-me-strong-secret

# Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# GPT input budget: tokens * CHARS_PER_TOKEN = max request chars
GPT_MAX_INPUT_TOKENS=32760
CHARS_PER_TOKEN=2

# N: retries for one block; M: full analysis restarts
GPT_BLOCK_RETRIES=3
GPT_ANALYSIS_RETRIES=2

# Upload limits
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=100

# PDF scan heuristic
PDF_MIN_CHARS_PER_PAGE=50
PDF_SCAN_IMAGE_PAGE_RATIO=0.5
PDF_FORCE_VISION=false
PDF_FORCE_TEXT=false

# YandexGPT (prompt + schema come in POST field "prompt")
YANDEX_GPT_MODEL=yandexgpt-5.1/latest
YANDEX_GPT_TEMPERATURE=0.1
YANDEX_GPT_MAX_TOKENS=2000

# Logging
LOG_DIR=logs
LOG_RETENTION=30 days
LOG_LEVEL=INFO

# Temp uploads
TEMP_DIR=tmp_uploads
